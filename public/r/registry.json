    {
      "name": "dock",
      "type": "registry:component",
      "title": "Dock",
      "description": "Docking layout: resizable splits, tab groups, drag tabs between groups or to any edge, maximize, and a saved layout.",
      "dependencies": [
        "@ui-sdk/react",
        "@ui-sdk/core",
        "@hugeicons/core-free-icons"
      ],
      "registryDependencies": [
        "@dockkit/button",
        "@dockkit/menu",
        "@dockkit/resizable",
        "@dockkit/utils",
        "@dockkit/icon"
      ],
      "files": [
        {
          "path": "src/components/dock/model.ts",
          "type": "registry:lib",
          "target": "components/dock/model.ts"
        },
