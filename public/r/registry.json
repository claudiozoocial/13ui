{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "dockkit",
  "homepage": "https://dockkit.vercel.app",
  "items": [
    {
      "name": "theme",
      "type": "registry:file",
      "title": "Dockkit theme",
      "description": "Design tokens on Tailwind's zinc scale, light and dark, density sizes, radii and the ui-sdk layer. Import it from your global stylesheet.",
      "files": [
        {
          "path": "src/styles/globals.css",
          "type": "registry:file",
          "target": "src/styles/dockkit.css"
        }
      ]
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "src/lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "dependencies": [
        "@ui-sdk/react",
        "@ui-sdk/core",
        "class-variance-authority"
      ],
      "registryDependencies": [
        "@dockkit/utils"
      ],
      "files": [
        {
          "path": "src/components/ui/button.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
