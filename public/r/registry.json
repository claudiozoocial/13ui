    {
      "name": "workbench",
      "type": "registry:block",
      "title": "Workbench",
      "description": "A full example: sidebar, chat, diff, files, terminal and browser panels in a dock, with a command palette.",
      "registryDependencies": [
        "@dockkit/dock",
        "@dockkit/app-shell",
        "@dockkit/chat",
        "@dockkit/command",
        "@dockkit/kbd",
        "@dockkit/menu",
        "@dockkit/tabs"
      ],
      "files": [
        {
          "path": "src/demo/App.tsx",
          "type": "registry:component",
          "target": "components/workbench.tsx"
        }
      ]
    }
  ]
